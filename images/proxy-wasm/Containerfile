# Coraza proxy-wasm plugin (operand).
#
# Source: coraza-proxy-wasm submodule at the repository root.
# Build context must be the repository root, not this directory.
#
# This is the image the operator points Istio at: the Engine controller
# applies a WasmPlugin referencing it, and Envoy pulls it and runs the module
# in-process. Istio expects the module at /plugin.wasm.

# The toolchain cannot be a stock Red Hat image - see tools/tinygo-builder
# for why.
#
# Digest-pinned so the plugin is always compiled by a known toolchain, and so
# that digest-rewriting automation can keep it current: a tag reference would
# be invisible to it and would silently stop being updated.
#
# For local builds, override it with the image "make image.tinygo-builder"
# produces:
#   podman build --build-arg BUILDER_IMAGE=localhost/waf-tinygo-builder:0.34.0 ...
ARG BUILDER_IMAGE=quay.io/redhat-user-workloads-stage/waf-tenant/waf-0-7/waf-tinygo-builder@sha256:db8a54bb9f9fb9db5e6f05060d7d307b6202e5a5b4d4d25a75127029092cfa9c

FROM ${BUILDER_IMAGE} AS builder

WORKDIR /src

# Resolve dependencies first so the layer caches independently of source edits.
#
# NOTE: coraza-proxy-wasm is a Go *workspace* - go.work covers both "." and
# "./magefiles", and the build below needs modules from both. Dependency
# prefetching must walk go.work rather than only the root go.mod, or a
# network-isolated build will fail resolving mage and wazero.
COPY coraza-proxy-wasm/go.mod coraza-proxy-wasm/go.sum ./
# Glob, not an explicit pair: go.work is committed upstream but go.work.sum is
# gitignored there, so it is absent from a clean checkout and naming it
# directly fails the build.
COPY coraza-proxy-wasm/go.work* ./
COPY coraza-proxy-wasm/magefiles/ magefiles/
RUN go mod download

COPY coraza-proxy-wasm/ .

# Default-on, matching upstream. Set to "false" to build without multiphase
# evaluation; the magefile drops the coraza.rule.multiphase_evaluation tag.
ARG MULTIPHASE_EVAL=true
ENV MULTIPHASE_EVAL=${MULTIPHASE_EVAL}

# Build via the upstream magefile rather than reimplementing it here.
#
# "mage build" does two things that must stay in lockstep with upstream: the
# TinyGo invocation with its exact build tags and initial heap size, and then
# patchWasm(), which rewrites specific wasip1 imports ("fd_filestat_get",
# "path_filestat_get") in the emitted module. Hand-copying that logic into
# this Containerfile would silently drift from upstream, and the failure mode
# is a plugin that builds cleanly and misbehaves inside Envoy. The magefile
# also asserts its minimum Go and TinyGo versions, which gives us a second
# guard on the toolchain image.
RUN go run mage.go build

# ---------------------------------------------------------------------------

# scratch, matching upstream. Besides being correct for a single-artifact wasm
# image, it inherits no labels - so unlike the operator image there is no risk
# of shipping UBI's cpe, url or description by accident.
FROM scratch

# The product's CPE identifier. Must match the value recorded in the release
# configuration exactly.
#
# Version-scoped: the 0.7 in it is the product stream, not the plugin
# version. A new stream needs a new CPE here and in the release
# configuration, changed together.
#
# el9 despite this image being FROM scratch: the CPE names the product and
# the RHEL generation it is built for and shipped against, not the contents
# of this particular layer.
ARG WAF_CPE="cpe:/a:redhat:web_application_firewall:0.7::el9"
# TODO(blocked on product): the customer-facing product URL.
ARG WAF_URL=""
# TODO: wire from the build pipeline; currently resolves to "unknown".
ARG CORAZA_PROXY_WASM_VERSION

# description and io.k8s.description must carry the SAME text, as the UBI
# images do, with summary holding the short form. Spelled out twice rather
# than shared via an ARG so no --build-arg can substitute product copy. Keep
# the two in sync by hand when editing either.
LABEL cpe="${WAF_CPE}" \
      url="${WAF_URL}" \
      version="${CORAZA_PROXY_WASM_VERSION:-unknown}" \
      name="waf-1/waf-proxy-wasm" \
      com.redhat.component="waf-proxy-wasm" \
      summary="Coraza WebAssembly plugin for Red Hat Web Application Firewall" \
      description="WebAssembly plugin that runs the Coraza Web Application Firewall engine inside Envoy, enforcing SecLang rules on Gateway API traffic. Loaded by Istio as a WasmPlugin on behalf of the Red Hat Web Application Firewall operator." \
      io.k8s.description="WebAssembly plugin that runs the Coraza Web Application Firewall engine inside Envoy, enforcing SecLang rules on Gateway API traffic. Loaded by Istio as a WasmPlugin on behalf of the Red Hat Web Application Firewall operator." \
      io.k8s.display-name="Red Hat Web Application Firewall Coraza plugin" \
      io.openshift.tags="waf,security,networking,wasm" \
      vendor="Red Hat, Inc."

# NOTE: this covers coraza-proxy-wasm itself. The plugin also embeds
# CoreRuleSet content at build time (wasmplugin/rules), whose licensing is an
# unresolved licensing question - a second licence file may be required
# here.
COPY coraza-proxy-wasm/LICENSE /licenses/LICENSE

COPY --from=builder /src/build/main.wasm /plugin.wasm
