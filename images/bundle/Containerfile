# OLM bundle for the Red Hat Web Application Firewall operator.
#
# Build context must be the repository root, not this directory.
#
# This image carries no code. Its contents are generated and committed by
# hack/generate-bundle.sh - see that script for why the manifests live in git
# rather than being produced during the build. In short: digest-rewriting
# automation can only update pullspecs that exist in a file in the
# repository, and the CSV is where the operator and plugin digests are
# pinned.
#
# This Component MUST be built single-arch: build-image-index: "false".
# A bundle must be a single OCI image manifest, never an image index.
#
# The upstream generator also emits a bundle/bundle.Dockerfile. It is
# deliberately not used; this reviewed file is the one that builds.

# scratch, as OLM requires. It also inherits no labels, so unlike the operator
# image there is no risk of shipping UBI's cpe, url or description.
FROM scratch

# ---------------------------------------------------------------------------
# OLM bundle labels
# ---------------------------------------------------------------------------
# These MUST agree with images/bundle/metadata/annotations.yaml. OLM reads the
# labels from the image and the annotations from the file; if they disagree
# the bundle is subtly wrong - wrong package or wrong channel - and nothing
# else catches it. hack/generate-bundle.sh cross-checks them on every run.
LABEL operators.operatorframework.io.bundle.mediatype.v1=registry+v1 \
      operators.operatorframework.io.bundle.manifests.v1=manifests/ \
      operators.operatorframework.io.bundle.metadata.v1=metadata/ \
      operators.operatorframework.io.bundle.package.v1=coraza-kubernetes-operator \
      operators.operatorframework.io.bundle.channels.v1=dev-preview \
      operators.operatorframework.io.bundle.channel.default.v1=dev-preview

# ---------------------------------------------------------------------------
# Red Hat product labels
# ---------------------------------------------------------------------------
# TODO: set to the product's CPE identifier once assigned. Must match the
# value recorded in the release configuration exactly. Left empty rather than
# given a placeholder so the policy check fails loudly instead of passing a
# value that is present but wrong.
ARG WAF_CPE=""
# TODO(blocked on product): the customer-facing product URL.
ARG WAF_URL=""
# TODO: wire from the build pipeline; currently resolves to "unknown".
ARG WAF_BUNDLE_VERSION

# description and io.k8s.description must carry the SAME text, as the UBI
# images do, with summary holding the short form. Spelled out twice rather
# than shared via an ARG so no --build-arg can substitute product copy. Keep
# the two in sync by hand when editing either.
LABEL cpe="${WAF_CPE}" \
      url="${WAF_URL}" \
      version="${WAF_BUNDLE_VERSION:-unknown}" \
      name="waf-1/waf-operator-bundle" \
      com.redhat.component="waf-operator-bundle" \
      summary="OLM bundle for Red Hat Web Application Firewall" \
      description="Operator Lifecycle Manager bundle for the Red Hat Web Application Firewall operator. Contains the ClusterServiceVersion, custom resource definitions and metadata that tell OLM how to install and upgrade the operator." \
      io.k8s.description="Operator Lifecycle Manager bundle for the Red Hat Web Application Firewall operator. Contains the ClusterServiceVersion, custom resource definitions and metadata that tell OLM how to install and upgrade the operator." \
      io.k8s.display-name="Red Hat Web Application Firewall operator bundle" \
      io.openshift.tags="waf,security,networking,olm" \
      vendor="Red Hat, Inc."

COPY coraza-kubernetes-operator/LICENSE /licenses/LICENSE

COPY images/bundle/manifests /manifests/
COPY images/bundle/metadata /metadata/
COPY images/bundle/tests/scorecard /tests/scorecard/
